# Every setting is optional; these are the defaults. Docker Compose reads the
# DERMA_WITH_NARRATOR and ANTHROPIC_API_KEY lines from a .env next to it; the
# rest are set in docker-compose.yml. A local `streamlit run` reads the process
# environment, so export what you need there.

# Longest side, in pixels, an image is shrunk to before any processing.
DERMA_PREVIEW_MAX_SIDE=1024
# Longest side of the downloaded before/after PNG.
DERMA_EXPORT_MAX_SIDE=2048
# Upload ceiling in MB. Keep server.maxUploadSize in .streamlit/config.toml equal.
DERMA_MAX_UPLOAD_MB=12
# SSIM threshold the identity signal is reported against.
DERMA_IDENTITY_MIN_SSIM=0.80
# auto, mediapipe or haar.
DERMA_FACE_DETECTOR=auto
# SDXL inpainting; needs requirements-ml.txt.
DERMA_ENABLE_GENERATIVE=false
DERMA_SDXL_MODEL_ID=diffusers/stable-diffusion-xl-1.0-inpainting-0.1
DERMA_SDXL_MAX_SIDE=768
# Claude-written consultation notes. Off, or no key, means the offline template.
DERMA_NARRATOR_ENABLED=true
DERMA_NARRATOR_MODEL=claude-opus-5
DERMA_LOG_LEVEL=INFO

# Build-time switch for Compose: true installs requirements-narrator.txt.
DERMA_WITH_NARRATOR=false
# Leave empty to use the template. Never commit a real key.
ANTHROPIC_API_KEY=
